STORAGE=local
ENV=local
LLM_PROVIDER=gemini
GEMINI_API_KEY=
USE_AGENT=false
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set MODEL_FAST, MODEL_STRONG and MODEL_ORCH to IDs enabled in your provider account.
# Append a generated API_TOKENS_JSON assignment using scripts/create_credentials.py.
# Every entry needs token (at least 20 characters), subject, role and org_ids.
# Never put credentials into VITE_* variables or commit .env.
